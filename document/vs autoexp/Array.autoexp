;------------------------------------------------------------------------------
;  hyc::FixArray
;------------------------------------------------------------------------------
hyc::FixArray<*>{
	children
	(
		#array
		(
			expr :		($e.m_ppT)[$i],
			size :		$e.m_len
		)
	)
	preview
	(
		#(
			"[", $e.m_len , "](",
			#array
			(
				expr :	($e.m_ppT)[$i],
				size :	$e.m_len
			),
			")"
		)
	)
}

