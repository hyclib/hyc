;------------------------------------------------------------------------------
;  hyc::Array
;------------------------------------------------------------------------------
hyc::Array<*>{
	children
	(
		#array
		(
			expr :		($e.m_pMem)[$i],
			size :		$e.m_curLen
		)
	)
	preview
	(
		#(
			"[", $e.m_curLen , "](",
			#array
			(
				expr :	($e.m_pMem)[$i],
				size :	$e.m_curLen
			),
			")"
		)
	)
}

